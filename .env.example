# anerp configuration (DESIGN.md §13). Copy to .env for local-to-the-codespace runs only.
# Never commit .env. Host secrets and GitHub Actions secrets are the source of truth.
ANERP_ENV=dev                                   # dev | demo | prod (gates reset_and_seed)
ANERP_DATABASE_URL=postgresql+psycopg://user:pass@host/anerp   # sqlite:///./anerp.db for a quick local run; falls back to DATABASE_URL (Railway), postgresql:// is rewritten
ANERP_BASE_CURRENCY=USD
ANERP_BOOTSTRAP_ADMIN_TOKEN=                    # generate: python -c "import secrets;print('anerp_'+secrets.token_urlsafe(32))"
ANERP_TOKEN_PEPPER=                             # random 32+ bytes; changing it invalidates all tokens
ANERP_SIGNING_KEY_PEM=                          # Ed25519 private key PEM (uv run anerp keygen); generated on first start and stored in server_key if unset
ANERP_ADVERTISE_OAUTH=false
ANERP_POLICY_PATH=./policies/default.yaml
ANERP_APPROVAL_TTL_HOURS=72
ANERP_REDACT_FIELDS=bank_account,tax_id,notes
ANERP_PORT=8000                                 # falls back to PORT (Railway)
ANERP_PUBLIC_URL=http://localhost:8000          # falls back to https://$RAILWAY_PUBLIC_DOMAIN
ANERP_LOG_LEVEL=INFO
ANERP_OTEL_ENABLED=false

# Internal agent / eval harness. Only the provider in use needs a key.
LLM_PROVIDER=none                               # anthropic | openai | google | none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Client-side only: token used by .mcp.json and the eval harness to reach a deployed server
ANERP_ADMIN_TOKEN=
ANERP_URL=http://localhost:8000
